{
  "name": "easy-to-figma",
  "version": "0.1.5",
  "private": true,
  "description": "Import PSD, Illustrator, and PowerPoint files into Figma while preserving editability.",
  "license": "MIT",
  "author": "FishXIN",
  "homepage": "https://github.com/FishXIN/easy-to-figma#readme",
  "bugs": {
    "url": "https://github.com/FishXIN/easy-to-figma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FishXIN/easy-to-figma.git"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "pptx",
    "photoshop",
    "illustrator",
    "design-import"
  ],
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "npm run dev -w @easy-to-figma/plugin",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
